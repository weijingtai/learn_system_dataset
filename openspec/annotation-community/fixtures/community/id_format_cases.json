      "name": "valid_note",
      "field": "note_id",
      "value": "note_0123456789abcdef0123456789abcdef",
      "expected": {
        "valid": true
      }
    },
    {
      "name": "valid_note_revision",
      "field": "note_revision_id",
      "value": "nrev_0123456789abcdef0123456789abcdef",
