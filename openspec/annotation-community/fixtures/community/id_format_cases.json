      "value": "cacc_0123456789abcdef0123456789abcdef",
      "expected": {
        "valid": true
      }
    },
    {
      "name": "valid_content_binding",
      "field": "content_binding_id",
      "value": "cbnd_0123456789abcdef0123456789abcdef",
      "expected": {
        "valid": true
      }
    },
    {
      "name": "valid_anchor_ref",
      "field": "anchor_ref_id",
      "value": "anc_0123456789abcdef0123456789abcdef",
      "expected": {
        "valid": true
      }
    },
    {
      "name": "valid_anchor_resolution",
