{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommunityCommentRevision",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "community_common.schema.json#/$defs/commentRevisionId"
    },
    "comment_id": {
      "$ref": "community_common.schema.json#/$defs/commentId"
    },
    "body": {
      "type": "string",
      "maxLength": 4000
    },
    "mentions": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/mentionRef"
      }
    },
    "parent_id": {
      "oneOf": [
        {
          "$ref": "community_common.schema.json#/$defs/commentRevisionId"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "community_common.schema.json#/$defs/timestamp"
    }
  },
  "required": [
    "id",
    "comment_id",
    "body",
    "mentions",
    "parent_id",
    "created_at"
  ],
  "$defs": {
    "mentionRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "$ref": "community_common.schema.json#/$defs/accountId"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "start_offset": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 2
        }
      },
      "required": [
        "user_id",
        "display_name",
        "start_offset",
        "length"
      ]
    }
  }
}
